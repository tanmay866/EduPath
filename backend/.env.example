# Backend configuration
#
# Copy to .env and fill in. This file holds real secrets in production — it is
# gitignored, and .env has been committed to this repository before, so treat
# anything that reaches git history as burned and rotate it.
#
#   cp backend/.env.example backend/.env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# Controls more than logging. While this is not "production" the CORS check
# accepts any localhost or private-network origin; setting it to production
# restricts requests to FRONTEND_URL alone. A deployment left in development
# mode is open to any origin that can reach it.
NODE_ENV=development

# Where the frontend is served from. No trailing slash — in production the
# origin is compared literally, so "https://app.com/" will not match
# "https://app.com" and every request is blocked by CORS.
#
# Also used for the links in verification and password-reset emails, so a wrong
# value sends users to a dead URL.
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out, which is the intended response to a leak.
JWT_SECRET=
JWT_EXPIRE=7d

# ── Python AI service ────────────────────────────────────────────────────────
# Roadmap generation and skill analysis. The backend returns 502 when it is
# unreachable, so the app degrades rather than breaking.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# Absolute path to the interpreter used by the ATS analyzer. On a host this is
# usually just "python3".
PYTHON_PATH=python3

# ── Email ────────────────────────────────────────────────────────────────────
# Setting BREVO_API_KEY switches all mail to Brevo's HTTPS API and ignores the
# SMTP block below. Required in production: hosts such as Render block outbound
# SMTP, so Gmail will silently fail to deliver there.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=EduPath

# Gmail SMTP, used only when BREVO_API_KEY is empty — i.e. local development.
# EMAIL_PASSWORD is a Google app password, not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ── Third-party services ─────────────────────────────────────────────────────
# Profile pictures and generated documents.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resume parsing for the portfolio generator.
GROQ_API_KEY=

# CS Fundamentals question bank (quizapi.io).
QUIZ_API_KEY=

# DOCX to PDF conversion in the resume builder.
FREECONVERT_API_KEY=

# Deploying generated portfolios to Vercel.
VERCEL_TOKEN=

# Hugging Face inference, used by the AI service.
HF_TOKEN=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Year component of generated login IDs (e.g. TAPA2026001).
CURRENT_YEAR=2026
