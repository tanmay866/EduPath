# AI service configuration
#
# Copy to .env and fill in. Read by config/settings.py at import time.
#
#   cp ai_service/.env.example ai_service/.env

# ── Server ───────────────────────────────────────────────────────────────────
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
ENVIRONMENT=development
DEBUG=true

# Browser origins allowed to call this service cross-origin, comma separated
# and without trailing slashes. Empty is correct for every current deployment:
# the frontend calls the Node backend and the backend calls this service
# server to server, and a server-to-server request carries no Origin header,
# so CORS never applies to it. Leave this unset unless something in a browser
# genuinely needs to reach this service directly.
AI_SERVICE_ALLOWED_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# Same cluster as the backend — this service writes its own assessment records.
MONGODB_URI=
DATABASE_NAME=edupath

# ── Language model ───────────────────────────────────────────────────────────
# Optional. Without a working model the service still answers every request:
# recommendations fall back to templates rather than being generated, and
# /health reports llm_loaded false so you can tell which mode you are in.
#
# Note the installed langchain-huggingface calls an API that newer
# huggingface_hub releases removed, so the model is currently unavailable
# regardless of this token. Fixing that is a dependency upgrade.
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_TOKEN=
LLM_MODEL=HuggingFaceH4/zephyr-7b-beta
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# ── Scoring weights ──────────────────────────────────────────────────────────
# How a skill-strength score is composed, and the bands it is read against.
ACCURACY_WEIGHT=0.6
DIFFICULTY_WEIGHT=0.4
BEGINNER_THRESHOLD=40
INTERMEDIATE_THRESHOLD=60
ADVANCED_THRESHOLD=80

# ── Runtime ──────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=30
MAX_RETRIES=3
MAX_WORKERS=4
USE_MODEL_CACHE=true
MODEL_CACHE_DIR=./.cache/models
CACHE_DIR=./.cache

LOG_LEVEL=INFO
LOG_FILE=./logs/ai_service.log

# Where the Node backend lives, for callbacks.
BACKEND_URL=http://localhost:4000
