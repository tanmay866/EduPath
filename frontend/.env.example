# Frontend configuration
#
# Copy to .env and fill in. Every value here is compiled into the JavaScript
# bundle that visitors download, so nothing secret belongs in this file — put
# secrets in backend/.env, which is never sent to the browser.
#
#   cp frontend/.env.example frontend/.env

# The public URL of the backend API. No trailing slash.
#
# Vite inlines this AT BUILD TIME, so changing it on the host does nothing
# until you redeploy — restarting will not pick it up.
#
#   local       http://localhost:4000
#   production  https://your-api.onrender.com
#
# This must be paired with FRONTEND_URL on the backend: the two point at each
# other, and the backend rejects requests from any other origin once
# NODE_ENV=production. If it is unset the app falls back to port 4000 on
# whichever host served the page and logs an error saying so.
VITE_API_URL=http://localhost:4000
